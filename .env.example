# Copie este arquivo para `.env.local` e ajuste os valores.
# Nenhuma variável é obrigatória para rodar a demo: sem elas o sistema
# entra em "modo demonstração" e persiste os dados apenas no navegador.

# URL pública do site (usada em metadados e links absolutos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo usado pela camada de sessão (troque em produção)
AUTH_SECRET=traga-um-segredo-forte-aqui
